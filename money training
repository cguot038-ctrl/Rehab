<!DOCTYPE html>
<html lang="zh-TW">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>新台幣收銀找錢練習輔具</title>
<style>
  :root {
    --bg-wood: #f7eedd;
    --tray-blue: #2a75d3;
    --c-1000: #2962ff;
    --c-500: #6d4c41;
    --c-100: #d32f2f;
    --c-50: #f5b041;
    --c-10: #a6acaf;
    --c-5: #bdc3c7;
    --c-1: #d35400;
  }
  * { box-sizing: border-box; font-family: "PingFang TC", "Microsoft JhengHei", sans-serif; user-select: none; }
  body { margin: 0; background: var(--bg-wood); display: flex; flex-direction: column; height: 100vh; overflow: hidden; }

  /* 頂部資訊列 */
  header {
    background: #fff3e0;
    padding: 10px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 3px solid #e0c39e;
  }
  .task-board {
    font-size: 26px;
    font-weight: bold;
    display: flex;
    gap: 20px;
    align-items: center;
  }
  .target-breakdown {
    background: #fff;
    padding: 8px 16px;
    border-radius: 12px;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .digit-box { font-size: 38px; font-weight: 900; }
  .d-100 { color: var(--c-100); }
  .d-10 { color: #5d6d7e; }
  .d-1 { color: var(--c-1); }

  /* 主工作區 */
  .main-container {
    display: flex;
    flex: 1;
    padding: 10px;
    gap: 15px;
    overflow: hidden;
  }

  /* 左側：托盤收銀盤 */
  .tray-section {
    flex: 1.2;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .tray {
    width: 95%;
    height: 60%;
    background: var(--tray-blue);
    border: 8px dashed #ffffff;
    border-radius: 30px;
    box-shadow: inset 0 0 15px rgba(0,0,0,0.3), 0 8px 15px rgba(0,0,0,0.2);
    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    padding: 15px;
    gap: 8px;
    overflow-y: auto;
  }
  .tray-status {
    margin-top: 10px;
    font-size: 24px;
    font-weight: bold;
    color: #333;
    display: flex;
    gap: 20px;
  }

  /* 右側：商品選單 */
  .shop-section {
    flex: 0.8;
    background: white;
    border-radius: 20px;
    padding: 15px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    display: flex;
    flex-direction: column;
  }
  .goods-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    overflow-y: auto;
    flex: 1;
  }
  .good-card {
    background: #fdfefe;
    border: 2px solid #e5e8e8;
    border-radius: 12px;
    padding: 10px;
    text-align: center;
    cursor: pointer;
    transition: transform 0.1s;
  }
  .good-card:active { transform: scale(0.96); }
  .good-card.active { border-color: #e67e22; background: #fff8e1; }
  .good-name { font-size: 18px; font-weight: bold; }
  .good-price { font-size: 20px; color: #d35400; font-weight: bold; }

  /* 底部：台幣錢箱 */
  .wallet-section {
    height: 140px;
    background: #ded0b6;
    display: flex;
    justify-content: space-around;
    align-items: center;
    padding: 0 15px;
    border-top: 4px solid #b8a07e;
  }

  /* 貨幣共同樣式 */
  .money-btn {
    cursor: pointer;
    box-shadow: 0 4px 6px rgba(0,0,0,0.25);
    display: flex;
    justify-content: center;
    align-items: center;
    font-weight: 900;
    transition: transform 0.1s;
  }
  .money-btn:active { transform: scale(0.92); }

  /* 紙鈔樣式 */
  .bill {
    width: 105px;
    height: 60px;
    border-radius: 6px;
    border: 2px solid #ffffff;
    color: white;
    font-size: 20px;
    letter-spacing: 1px;
  }
  .b-1000 { background: var(--c-1000); }
  .b-500 { background: var(--c-500); }
  .b-100 { background: var(--c-100); }

  /* 硬幣樣式 */
  .coin {
    border-radius: 50%;
    color: #333;
    border: 2px solid rgba(0,0,0,0.2);
  }
  .c-50 { width: 62px; height: 62px; background: var(--c-50); font-size: 22px; color: #5d4037; }
  .c-10 { width: 54px; height: 54px; background: radial-gradient(circle, #f1c40f 40%, var(--c-10) 42%); font-size: 18px; }
  .c-5 { width: 48px; height: 48px; background: var(--c-5); font-size: 17px; }
  .c-1 { width: 42px; height: 42px; background: var(--c-1); color: white; font-size: 16px; }

  /* 提示標籤與張數統計 */
  .counter-badge {
    background: #27ae60;
    color: white;
    border-radius: 10px;
    padding: 2px 8px;
    font-size: 14px;
    margin-left: 5px;
  }
  .action-btn {
    padding: 10px 20px;
    font-size: 18px;
    font-weight: bold;
    border-radius: 10px;
    border: none;
    cursor: pointer;
  }
  .btn-clear { background: #e74c3c; color: white; }
  .btn-check { background: #2ecc71; color: white; }
</style>
</head>
<body>

<header>
  <div class="task-board">
    <span id="mode-text">應找金額：</span>
    <div class="target-breakdown" id="display-target">
      <!-- 數字會動態呈現紅字拆解 -->
      $<span id="amt-large" style="letter-spacing: 2px;">661</span>
    </div>
  </div>
  <div>
    <button class="action-btn btn-clear" onclick="clearTray()">重新放</button>
    <button class="action-btn btn-check" onclick="verifyAmount()">完成確認</button>
  </div>
</header>

<div class="main-container">
  <!-- 左側托盤 -->
  <div class="tray-section">
    <div class="tray" id="tray" onclick="removeLastMoney()"></div>
    <div class="tray-status">
      <div>已放金額：$<span id="current-sum" style="color:#d32f2f;">0</span></div>
      <div id="count-details">張數/枚數：0</div>
    </div>
    <small style="color: #666; margin-top: 5px;">（點擊托盤內任意錢幣可單個收回）</small>
  </div>

  <!-- 右側商品挑選 -->
  <div class="shop-section">
    <h3 style="margin-top:0;">挑選商品練習</h3>
    <div class="goods-grid" id="goods-list"></div>
  </div>
</div>

<!-- 底部真實錢幣選單 -->
<div class="wallet-section">
  <div class="money-btn bill b-1000" onclick="addMoney(1000)">$1000</div>
  <div class="money-btn bill b-500" onclick="addMoney(500)">$500</div>
  <div class="money-btn bill b-100" onclick="addMoney(100)">$100</div>
  <div class="money-btn coin c-50" onclick="addMoney(50)">$50</div>
  <div class="money-btn coin c-10" onclick="addMoney(10)">$10</div>
  <div class="money-btn coin c-5" onclick="addMoney(5)">$5</div>
  <div class="money-btn coin c-1" onclick="addMoney(1)">$1</div>
</div>

<script>
  // 示範商品庫
  const goods = [
    { name: "橡皮擦", price: 339, icon: "✏️" },
    { name: "彩色筆", price: 345, icon: "🖍️" },
    { name: "蘋果", price: 385, icon: "🍎" },
    { name: "鮮奶", price: 40, icon: "🥛" },
    { name: "吐司麵包", price: 299, icon: "🍞" },
    { name: "故事書", price: 508, icon: "📖" }
  ];

  let targetAmount = 661;
  let trayMoney = [];

  // 初始化商品列表
  function renderGoods() {
    const list = document.getElementById("goods-list");
    list.innerHTML = "";
    goods.forEach((g, idx) => {
      const card = document.createElement("div");
      card.className = "good-card";
      card.innerHTML = `<div style="font-size:32px;">${g.icon}</div>
                        <div class="good-name">${g.name}</div>
                        <div class="good-price">$${g.price}</div>`;
      card.onclick = () => selectGood(g);
      list.appendChild(card);
    });
  }

  // 選取商品計算找錢題型 (預設拿1000元來買)
  function selectGood(good) {
    const paid = 1000;
    targetAmount = paid - good.price;
    updateTargetDisplay();
    clearTray();
  }

  // 更新大數字拆解提示 (將百位標註紅色、十位標灰、個位標銅色)
  function updateTargetDisplay() {
    const amtStr = targetAmount.toString().padStart(3, '0');
    const h = amtStr[amtStr.length - 3] || '0';
    const t = amtStr[amtStr.length - 2] || '0';
    const o = amtStr[amtStr.length - 1] || '0';

    const container = document.getElementById("display-target");
    container.innerHTML = `
      <span class="digit-box d-100">${h}</span><small style="color:var(--c-100)">百</small>
      <span class="digit-box d-10">${t}</span><small style="color:#5d6d7e">十</small>
      <span class="digit-box d-1">${o}</span><small style="color:var(--c-1)">元</small>
      <span style="font-size:20px; color:#555; margin-left:10px;">(共 $${targetAmount})</span>
    `;
  }

  // 放入錢幣
  function addMoney(val) {
    trayMoney.push(val);
    renderTray();
  }

  // 點擊托盤移除最後一個放進去的錢幣
  function removeLastMoney() {
    if (trayMoney.length > 0) {
      trayMoney.pop();
      renderTray();
    }
  }

  // 清空
  function clearTray() {
    trayMoney = [];
    renderTray();
  }

  // 畫面更新：計算張數與顏色標籤
  function renderTray() {
    const tray = document.getElementById("tray");
    tray.innerHTML = "";
    
    // 計算每種面額放了幾張
    const counts = { 1000:0, 500:0, 100:0, 50:0, 10:0, 5:0, 1:0 };
    let currentSum = 0;

    trayMoney.forEach(val => {
      counts[val]++;
      currentSum += val;

      const item = document.createElement("div");
      if (val >= 100) {
        item.className = `money-btn bill b-${val}`;
      } else {
        item.className = `money-btn coin c-${val}`;
      }
      item.innerText = `$${val}`;
      tray.appendChild(item);
    });

    document.getElementById("current-sum").innerText = currentSum;

    // 即時統計文字：特別標註 100元放了幾張
    let countText = [];
    if(counts[100] > 0) countText.push(`<b style="color:red">100元: ${counts[100]}張</b>`);
    if(counts[50] > 0) countText.push(`50元: ${counts[50]}個`);
    if(counts[10] > 0) countText.push(`10元: ${counts[10]}個`);
    if(counts[5] > 0) countText.push(`5元: ${counts[5]}個`);
    if(counts[1] > 0) countText.push(`1元: ${counts[1]}個`);
    
    document.getElementById("count-details").innerHTML = countText.length > 0 
      ? countText.join(" ｜ ") 
      : "尚未放置錢幣";
  }

  // 確認結果
  function verifyAmount() {
    const currentSum = trayMoney.reduce((a, b) => a + b, 0);
    if (currentSum === targetAmount) {
      alert("太棒了！金額完全正確！🎉");
    } else if (currentSum < targetAmount) {
      alert(`還不夠喔！現在只有 $${currentSum}，還差 $${targetAmount - currentSum}`);
    } else {
      alert(`放太多了喔！現在是 $${currentSum}，多了 $${currentSum - targetAmount}`);
    }
  }

  // 初始化
  renderGoods();
  updateTargetDisplay();
</script>
</body>
</html>
